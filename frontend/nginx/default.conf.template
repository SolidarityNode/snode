# Rendered by the nginx image entrypoint (envsubst) at container start.
# NGINX_LOCAL_RESOLVERS is the container's DNS server (Podman or Docker), filled in by the
# entrypoint because NGINX_ENTRYPOINT_LOCAL_RESOLVERS is set in the Containerfile.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    # Send the origin (not the full URL) as Referer on cross-origin requests. Map tile servers
    # need it: the OSMF tile usage policy requires a valid Referer (ADR 0007). Never use
    # no-referrer or same-origin here. Applies to every location (none sets its own add_header).
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Re-resolve the backend name, so a restarted backend container (new IP) is found again.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

    # API: same-origin proxy to the backend, so the browser needs no CORS.
    location /api/ {
        set $backend_upstream ${BACKEND_UPSTREAM};
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $backend_upstream;
        # Uploads (data packages, hub raw sources) are streamed to the backend, which applies its
        # own limits; without this nginx refuses bodies over 1 MB with 413 before the API sees
        # them. NGINX_CLIENT_MAX_BODY_SIZE (default 4096m) sets the outer limit.
        client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};
        proxy_request_buffering off;
        proxy_read_timeout 600s;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        # The browser's address, for sign-in throttling per client address (ADR 0015). nginx is
        # the edge, so it overwrites (never appends to) any X-Real-IP / X-Forwarded-For a client
        # sends. The backend trusts them only from SOLIDARITYNODE_TRUSTED_PROXIES. Behind
        # rootless Podman's port forwarder $remote_addr is nginx's own address; the backend then
        # treats the client address as unknown and throttles per username only.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    # Single-page app routing.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
