# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
coverage.xml
htmlcov/
build/
dist/

# --- Node ---
node_modules/
frontend/dist/
frontend/coverage/
*.tsbuildinfo
.pnpm-store/

# --- Environment and secrets ---
.env
.env.*
!.env.example

# --- Data ---
# Only synthetic data is ever committed (see AGENTS.md). Real data stays outside the repo.
# Real open data (OpenStreetMap, ELSTAT, DEM, GTFS) is downloaded to data/local/ by scripts.
data/*
data/local/
!data/synthetic/
!data/README.md
*.parquet
*.gpkg
*.shp
*.dbf
*.shx
*.prj
!core/tests/fixtures/**
!data/synthetic/**

# --- QGIS and GeoPackage temporary files (also inside data/synthetic/) ---
*.qgz~
*.qgs~
.qgis*
*.gpkg-wal
*.gpkg-shm
*.gpkg-journal

# --- Editors and OS ---
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Re-apply cache ignores below the data exceptions above.
**/__pycache__/
*.py[cod]

# Playwright output
frontend/test-results/
frontend/playwright-report/
# Local results (backend on the host)
backend/var/
site/
