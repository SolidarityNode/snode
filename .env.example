# Copy to .env and adjust. Never commit .env.
# Every value has a default in compose.yaml, so `make up` also works without a .env file.

# --- Database (PostGIS container) ---
POSTGRES_DB=solidaritynode
POSTGRES_USER=solidaritynode
# Local development only. Choose your own value; never reuse it anywhere else.
POSTGRES_PASSWORD=change-me-local-only
# Host port for the database (non-privileged, >= 1024).
DB_HOST_PORT=5432

# --- Backend ---
# Used by the backend inside the compose network. For a backend running on the host,
# replace "db" with "localhost" and the port with DB_HOST_PORT.
SOLIDARITYNODE_DATABASE_URL=postgresql+psycopg://solidaritynode:change-me-local-only@db:5432/solidaritynode
SOLIDARITYNODE_ENVIRONMENT=development
SOLIDARITYNODE_LOG_LEVEL=info
BACKEND_HOST_PORT=8000

# --- Frontend ---
FRONTEND_HOST_PORT=8080
