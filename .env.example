# Copy to .env (`make setup` does this if .env is missing). Never commit .env.
# Defaults are safe for local development; every value also has a default in compose.yaml.
# Secrets are "change-me" placeholders: the backend refuses them when APP_ENV=production.
# Each setting is described in CONTRIBUTING.md, "Configuration".

# --- Database (PostGIS container) ---
# Database name created in the PostGIS container.
POSTGRES_DB=solidaritynode
# Database user created in the PostGIS container.
POSTGRES_USER=solidaritynode
# Database password (secret). Replace before any non-development use.
POSTGRES_PASSWORD=change-me

# --- Host ports (non-privileged, >= 1024, bound to 127.0.0.1) ---
# Host port for PostgreSQL.
DB_HOST_PORT=5432
# Host port for the backend API.
BACKEND_HOST_PORT=8000
# Host port for the frontend.
FRONTEND_HOST_PORT=8080

# --- Backend ---
# development | test | production. Outside development and test, placeholder secrets are refused.
APP_ENV=development
# Backend log level: debug | info | warning | error.
SOLIDARITYNODE_LOG_LEVEL=info
# Database URL for a backend run on the host (in compose it is built from POSTGRES_* above).
# SOLIDARITYNODE_DATABASE_URL=postgresql+psycopg://solidaritynode:change-me@localhost:5432/solidaritynode
# Browser origins allowed to call the API directly (JSON list); the Vite dev server by default.
# SOLIDARITYNODE_CORS_ORIGINS=["http://localhost:5173"]
# Role of this installation: municipality (one study area) or hub. Only municipality is complete
# in v0.1; hub onboarding comes later (ADR 0012).
DEPLOYMENT_MODE=municipality
# Map background: osm (OpenStreetMap tiles, needs internet, attributed) or blank (offline).
SOLIDARITYNODE_BASEMAP=osm
# Pause in seconds after each progress step of a run, so progress and cancel can be followed.
SOLIDARITYNODE_DIAGNOSTIC_STEP_DELAY_S=0.5
# Login session lifetime in hours.
SOLIDARITYNODE_SESSION_HOURS=12
# Send the session cookie only over HTTPS (true behind TLS in production).
SOLIDARITYNODE_SESSION_COOKIE_SECURE=false
# Directory for per-sample results (Parquet) and package uploads for a backend run on the host
# (in compose it is the `results` volume at /data/results).
# SOLIDARITYNODE_RESULTS_DIR=var/results
# Directory of data packages offered on the Admin screen (in compose: the demo packages).
# SOLIDARITYNODE_PACKAGES_DIR=data/synthetic/packages
# Name of a worker process, shown in logs and on its jobs only.
# SOLIDARITYNODE_WORKER_NAME=worker
# Seconds between heartbeats of a running job (its lease, renewed by the worker).
# SOLIDARITYNODE_JOB_HEARTBEAT_SECONDS=10
# A running job without a heartbeat for this many seconds is failed by any worker (>= 2 x heartbeat).
# SOLIDARITYNODE_JOB_STALE_SECONDS=120
# Quantile levels of the interval stored with every result value, as low,high (0 < low < 0.5 < high < 1).
SOLIDARITYNODE_RESULT_INTERVAL_QUANTILES=0.05,0.95
# Optional maximum runtime per job kind, as kind=seconds pairs (for example run=3600); empty: no limit.
# SOLIDARITYNODE_JOB_MAX_RUNTIME_SECONDS=
# PostgreSQL/PostGIS server for the backend tests (a throw-away database is created on it).
# SOLIDARITYNODE_TEST_DATABASE_URL=postgresql+psycopg://solidaritynode:change-me@127.0.0.1:5432/solidaritynode

# --- Build identity ---
# Git commit shown by /version and the frontend footer; `make up` sets it automatically.
# GIT_COMMIT=unknown

# --- Container engine (optional; defaults come from the Makefile) ---
# Container engine command: podman (default) or docker.
# CONTAINER_ENGINE=podman
# Compose command: "podman compose" (default) or "docker compose".
# COMPOSE=podman compose
