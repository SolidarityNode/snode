# Copy to .env and adjust. Never commit .env.
# Every value has a default in compose.yaml, so `make up` also works without a .env file.

# --- Database (PostGIS container) ---
POSTGRES_DB=solidaritynode
POSTGRES_USER=solidaritynode
# Placeholder. Any value starting with "change-me" is refused when APP_ENV=production.
POSTGRES_PASSWORD=change-me

# --- Host ports (non-privileged, >= 1024, bound to 127.0.0.1) ---
DB_HOST_PORT=5432
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=8080

# --- Backend ---
# Inside compose, the database URL is assembled from the POSTGRES_* values above.
# For a backend running on the host (uv run uvicorn ...), export instead:
# SOLIDARITYNODE_DATABASE_URL=postgresql+psycopg://solidaritynode:change-me@localhost:5432/solidaritynode
# development | test | production. Outside development and test the backend refuses to start
# while any secret still starts with "change-me".
APP_ENV=development
SOLIDARITYNODE_LOG_LEVEL=info

# --- Container engine (optional; defaults come from the Makefile) ---
# CONTAINER_ENGINE=podman
# COMPOSE=podman compose
