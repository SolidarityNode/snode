{
  "$defs": {
    "CapacityChangeIn": {
      "additionalProperties": false,
      "description": "Change one capacity input of an existing facility (Paper 1 \u00a713).",
      "properties": {
        "amount": {
          "description": "Signed change",
          "title": "Amount",
          "type": "number"
        },
        "capacity_input": {
          "enum": [
            "places",
            "staff",
            "throughput"
          ],
          "title": "Capacity Input",
          "type": "string"
        },
        "facility_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Facility Id",
          "type": "string"
        },
        "mode": {
          "description": "absolute: in the input's own unit; relative: percent of the baseline value",
          "enum": [
            "absolute",
            "relative"
          ],
          "title": "Mode",
          "type": "string"
        },
        "service_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Service Id",
          "type": "string"
        }
      },
      "required": [
        "facility_id",
        "service_id",
        "capacity_input",
        "mode",
        "amount"
      ],
      "title": "CapacityChangeIn",
      "type": "object"
    },
    "EdgeChangeIn": {
      "additionalProperties": false,
      "description": "Change the travel time or speed of one edge for one mode (Paper 1 \u00a713, \u00a715.7).\n\nA placeholder: checked and recorded, not applied yet. The value must stay strictly\npositive (a relative change above -100 %); a road is closed with ``closed_edges``.",
      "properties": {
        "amount": {
          "description": "Signed change",
          "title": "Amount",
          "type": "number"
        },
        "change": {
          "description": "absolute: minutes (travel time) or km/h (speed); relative: percent",
          "enum": [
            "absolute",
            "relative"
          ],
          "title": "Change",
          "type": "string"
        },
        "edge_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Edge Id",
          "type": "string"
        },
        "mode": {
          "enum": [
            "walk",
            "car",
            "public_transport"
          ],
          "title": "Mode",
          "type": "string"
        },
        "quantity": {
          "enum": [
            "travel_time",
            "speed"
          ],
          "title": "Quantity",
          "type": "string"
        }
      },
      "required": [
        "edge_id",
        "mode",
        "quantity",
        "change",
        "amount"
      ],
      "title": "EdgeChangeIn",
      "type": "object"
    },
    "NetworkChangesIn": {
      "additionalProperties": false,
      "description": "Network interventions: edge changes and new edges (placeholders, recorded only).",
      "properties": {
        "edge_changes": {
          "items": {
            "$ref": "#/$defs/EdgeChangeIn"
          },
          "title": "Edge Changes",
          "type": "array"
        },
        "new_edges": {
          "items": {
            "$ref": "#/$defs/NewEdgeIn"
          },
          "title": "New Edges",
          "type": "array"
        }
      },
      "title": "NetworkChangesIn",
      "type": "object"
    },
    "NetworkClosureIn": {
      "additionalProperties": false,
      "description": "Network edges closed for the given modes (Paper 3 \u00a79).",
      "properties": {
        "edge_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Edge Ids",
          "type": "array"
        },
        "modes": {
          "items": {
            "enum": [
              "walk",
              "car",
              "public_transport"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Modes",
          "type": "array"
        }
      },
      "required": [
        "edge_ids",
        "modes"
      ],
      "title": "NetworkClosureIn",
      "type": "object"
    },
    "NewEdgeIn": {
      "additionalProperties": false,
      "description": "A new network edge between two existing nodes (Paper 1 \u00a713, \u00a715.7; placeholder).",
      "properties": {
        "closable": {
          "default": true,
          "description": "Whether disruptions may close it",
          "title": "Closable",
          "type": "boolean"
        },
        "edge_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Edge Id",
          "type": "string"
        },
        "from_node_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "From Node Id",
          "type": "string"
        },
        "to_node_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "To Node Id",
          "type": "string"
        },
        "travel_time_min": {
          "additionalProperties": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "description": "Minutes to traverse the edge per mode (> 0)",
          "minProperties": 1,
          "propertyNames": {
            "enum": [
              "walk",
              "car",
              "public_transport"
            ]
          },
          "title": "Travel Time Min",
          "type": "object"
        }
      },
      "required": [
        "edge_id",
        "from_node_id",
        "to_node_id",
        "travel_time_min"
      ],
      "title": "NewEdgeIn",
      "type": "object"
    },
    "NewFacilityIn": {
      "additionalProperties": false,
      "description": "Add a facility that is not in the baseline, at an existing network node (Paper 1 \u00a713).",
      "properties": {
        "facility_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Facility Id",
          "type": "string"
        },
        "facility_type": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Facility Type",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "node_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Node Id",
          "type": "string"
        },
        "services": {
          "items": {
            "$ref": "#/$defs/ServiceCapacityIn"
          },
          "minItems": 1,
          "title": "Services",
          "type": "array"
        }
      },
      "required": [
        "facility_id",
        "name",
        "facility_type",
        "node_id",
        "services"
      ],
      "title": "NewFacilityIn",
      "type": "object"
    },
    "PopulationChangeIn": {
      "additionalProperties": false,
      "description": "Change the population of one group in one unit (Paper 1 \u00a713, \u00a715.7; placeholder).",
      "properties": {
        "amount": {
          "description": "Signed change",
          "title": "Amount",
          "type": "number"
        },
        "change": {
          "description": "absolute: persons; relative: percent of the baseline count",
          "enum": [
            "absolute",
            "relative"
          ],
          "title": "Change",
          "type": "string"
        },
        "group_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Group Id",
          "type": "string"
        },
        "unit_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Unit Id",
          "type": "string"
        }
      },
      "required": [
        "unit_id",
        "group_id",
        "change",
        "amount"
      ],
      "title": "PopulationChangeIn",
      "type": "object"
    },
    "ServiceCapacityIn": {
      "additionalProperties": false,
      "description": "Capacity inputs of a new facility for one service.",
      "properties": {
        "places": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Places"
        },
        "service_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Service Id",
          "type": "string"
        },
        "staff": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Staff"
        },
        "throughput": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Throughput"
        }
      },
      "required": [
        "service_id"
      ],
      "title": "ServiceCapacityIn",
      "type": "object"
    },
    "SeverityIn": {
      "additionalProperties": false,
      "description": "Disruption severity ``DS_{f,c}`` of one facility (Paper 3 \u00a77\u201310).",
      "properties": {
        "facility_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Facility Id",
          "type": "string"
        },
        "severity": {
          "maximum": 1,
          "minimum": 0,
          "title": "Severity",
          "type": "number"
        }
      },
      "required": [
        "facility_id",
        "severity"
      ],
      "title": "SeverityIn",
      "type": "object"
    }
  },
  "$id": "urn:solidaritynode:schema:scenario:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The overlay of one scenario version (Spec 00 \u00a73; ADR 0016).\n\n``reference_level`` is the reference-scenario flag: ``null`` for an ordinary scenario, or\nthe standardised level it stands for (OQ-16; how reference scenarios are constructed is\nopen). Disruption scenarios (any severity or closed edge) must state a ``rationing`` case\n(OQ-24). ``network_changes`` and ``population_changes`` are placeholders: validated against\nthe data and recorded on runs, without behaviour yet. Order of application: interventions,\nthen disruptions (ADR 0016; OQ-30, proposed).",
  "properties": {
    "capacity_changes": {
      "items": {
        "$ref": "#/$defs/CapacityChangeIn"
      },
      "title": "Capacity Changes",
      "type": "array"
    },
    "closed_edges": {
      "anyOf": [
        {
          "$ref": "#/$defs/NetworkClosureIn"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "network_changes": {
      "$ref": "#/$defs/NetworkChangesIn"
    },
    "new_facilities": {
      "items": {
        "$ref": "#/$defs/NewFacilityIn"
      },
      "title": "New Facilities",
      "type": "array"
    },
    "population_changes": {
      "items": {
        "$ref": "#/$defs/PopulationChangeIn"
      },
      "title": "Population Changes",
      "type": "array"
    },
    "rationing": {
      "anyOf": [
        {
          "enum": [
            "uniform",
            "concentrated"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rationing"
    },
    "reference_level": {
      "anyOf": [
        {
          "enum": [
            "minor",
            "moderate",
            "severe"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reference Level"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "severities": {
      "items": {
        "$ref": "#/$defs/SeverityIn"
      },
      "title": "Severities",
      "type": "array"
    }
  },
  "title": "ScenarioBody",
  "type": "object"
}
